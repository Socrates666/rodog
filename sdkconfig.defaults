# Default SDK configuration for WaveGo Display

# FreeRTOS configuration
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=100

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# I2C configuration
CONFIG_I2C_MASTER_FREQ_HZ=400000

# OLED display
CONFIG_I2C_MASTER_SCL_IO=22
CONFIG_I2C_MASTER_SDA_IO=21

# WiFi configuration (for IP display)
CONFIG_ESP_WIFI_STA_AUTOCONNECT=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_SSID="YourWiFiSSID"
CONFIG_ESP_WIFI_PASSWORD="YourWiFiPassword"

# Networking
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=y

# NVS configuration
CONFIG_NVS_ENCRYPTION=n

# Component manager
CONFIG_COMPILER_OPTIMIZATION_PERF=y